# Frontend environment variables. Copy to .env and fill in.
#
# Everything here ends up in the client bundle — never put a secret in a
# VITE_-prefixed variable. The Anthropic API key lives only in
# server/.env, never here.

# Base URL of the Express backend (chat proxy + session store). Optional —
# defaults to http://localhost:8787 if unset.
VITE_API_BASE_URL=http://localhost:8787

# Supabase project URL and anon/public key, from your project's
# Settings -> API page. The anon key is NOT a secret — it's designed to
# ship in the client bundle and is meant to be governed by the Row Level
# Security policies in supabase/schema.sql. Never put the service_role key
# here or anywhere in frontend code.
#
# Required to log in: authentication (login/register/password recovery) is
# handled by Supabase Auth, so these two vars must be set for the dashboard
# to be reachable at all -- without them every dashboard route redirects to
# /login, which shows a "Supabase no configurado" message instead of a form.
# Independent of VITE_DATA_BACKEND below.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Which repository implementation the app uses for leads/forms/chat
# settings: "local" (browser localStorage, the default) or "supabase"
# (the database configured above). Chat sessions are unaffected either
# way — they always go through the backend's server/data/sessions.json.
VITE_DATA_BACKEND=local
