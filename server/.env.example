# Port the backend listens on.
PORT=8787

# Anthropic API key. Server-side only — never prefix this with VITE_ or read it
# from frontend code. Leave empty to run the app without AI configured (the
# health endpoint and the public chat page will report AI as unavailable
# instead of crashing).
ANTHROPIC_API_KEY=

# Model used for the qualification chat. Keep this in server config, not
# hard-coded across the codebase, and never let the frontend choose it.
ANTHROPIC_MODEL=claude-opus-4-8

# Per-organization monthly quotas for the AI chat (see
# supabase/migrations-usage-quotas.sql). OFF unless exactly "true". While
# off, the chat never touches any quota table or function, so that
# migration does not even need to be applied. Turning it on requires the
# migration, Supabase (SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY below) and
# each organization's own enforcement_mode in organization_quotas.
CHAT_QUOTAS_ENABLED=false

# Comma-separated list of origins allowed to call this API (dev: the Vite
# frontend origin).
CORS_ORIGIN=http://localhost:5173

# Webhooks feature only (server-side Supabase access for
# webhook_configurations/webhook_deliveries — see supabase/migrations-webhooks.sql).
# Both optional: leave empty to run the app with Webhooks disabled — the
# existing chat/Anthropic routes keep working normally either way, exactly
# like an unset ANTHROPIC_API_KEY above. GET/PUT /api/webhooks/* and the
# delivery worker report themselves as unavailable (503) instead of
# crashing the process when these are unset.
#
# SUPABASE_URL: same value as the frontend's VITE_SUPABASE_URL (Settings ->
# API in the Supabase dashboard) — not a secret on its own.
SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY: the `service_role` key from the same Settings
# -> API page. This IS a secret — it bypasses Row Level Security entirely.
# Server-side only, exactly like ANTHROPIC_API_KEY above: never prefix with
# VITE_, never reference from any frontend code, never log it, never
# include it in an HTTP response. Only server/src/lib/supabase-client.ts
# reads it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Technical cap on visitor messages per chat conversation (not a
# billing limit). Unset, malformed or non-positive values fall back to 25.
# CHAT_MAX_USER_MESSAGES=25

# HubSpot CRM integration — all optional. The integration only turns on when
# ALL FIVE of these are set (plus SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY);
# with any missing, /api/hubspot/* report it as not configured and the rest
# of the app is unaffected.
#
# FRONTEND_URL: the frontend's own origin (e.g. https://app.example.com, no
# trailing slash). Where the OAuth callback sends the user back
# (<FRONTEND_URL>/integrations).
# FRONTEND_URL=
#
# From your HubSpot app (developer account). HUBSPOT_CLIENT_SECRET IS a secret.
# HUBSPOT_REDIRECT_URI must be this backend's /api/hubspot/oauth/callback URL
# and must match the redirect URL registered in the HubSpot app exactly.
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# HUBSPOT_REDIRECT_URI=
#
# HUBSPOT_TOKEN_ENCRYPTION_KEY: SECRET. Exactly 32 random bytes, base64
# (AES-256 key that encrypts stored HubSpot tokens). Generate one per
# environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never reuse production's key elsewhere, and never rotate it without
# reconnecting HubSpot: tokens encrypted with the old key can't be read.
# HUBSPOT_TOKEN_ENCRYPTION_KEY=
