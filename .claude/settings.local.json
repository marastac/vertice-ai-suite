      "Bash(curl -s -o /dev/null -w \"index.css: %{http_code}\\\\n\" http://localhost:5173/src/index.css)",
      "Bash(curl -s http://localhost:5173/src/App.tsx)",
      "Bash(node -e \"console.log\\(require\\('./node_modules/zod/package.json'\\).version\\)\")",
      "Bash(node -e \"console.log\\(require\\('./node_modules/react-hook-form/package.json'\\).version\\)\")",
      "Bash(node -e \"console.log\\(require\\('./node_modules/@hookform/resolvers/package.json'\\).version\\)\")",
