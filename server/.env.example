# Port the backend listens on.
PORT=8787

# Anthropic API key. Server-side only — never prefix this with VITE_ or read it
# from frontend code. Leave empty to run the app without AI configured (the
# health endpoint and the public chat page will report AI as unavailable
# instead of crashing).
ANTHROPIC_API_KEY=

# Model used for the qualification chat. Keep this in server config, not
# hard-coded across the codebase, and never let the frontend choose it.
ANTHROPIC_MODEL=claude-opus-4-8

# Comma-separated list of origins allowed to call this API (dev: the Vite
# frontend origin).
CORS_ORIGIN=http://localhost:5173

# Webhooks feature only (server-side Supabase access for
# webhook_configurations/webhook_deliveries — see supabase/migrations-webhooks.sql).
# Both optional: leave empty to run the app with Webhooks disabled — the
# existing chat/Anthropic routes keep working normally either way, exactly
# like an unset ANTHROPIC_API_KEY above. GET/PUT /api/webhooks/* and the
# delivery worker report themselves as unavailable (503) instead of
# crashing the process when these are unset.
#
# SUPABASE_URL: same value as the frontend's VITE_SUPABASE_URL (Settings ->
# API in the Supabase dashboard) — not a secret on its own.
SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY: the `service_role` key from the same Settings
# -> API page. This IS a secret — it bypasses Row Level Security entirely.
# Server-side only, exactly like ANTHROPIC_API_KEY above: never prefix with
# VITE_, never reference from any frontend code, never log it, never
# include it in an HTTP response. Only server/src/lib/supabase-client.ts
# reads it.
SUPABASE_SERVICE_ROLE_KEY=
